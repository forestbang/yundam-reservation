      ".write": "auth != null"
    },
    "menu": {
      ".read": true,
      ".write": "auth != null"
    },
    "businessHours": {
      ".read": true,
      ".write": "auth != null"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null"
    },
    "restaurant": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
